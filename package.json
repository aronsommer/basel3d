{
  "name": "basel3d",
  "private": true,
  "type": "module",
  "scripts": {
    "buildings": "node tools/buildings.mjs && node tools/size.mjs",
    "terrain": "node tools/terrain.mjs && node tools/size.mjs",
    "trees": "node tools/trees.mjs && node tools/size.mjs",
    "map": "node tools/map.mjs && node tools/size.mjs",
    "bridges": "node tools/bridges.mjs && node tools/size.mjs",
    "trams": "node tools/paths.mjs tram && node tools/size.mjs",
    "trains": "node tools/paths.mjs train && node tools/size.mjs",
    "cars": "node tools/paths.mjs car && node tools/size.mjs",
    "ships": "node tools/ships.mjs && node tools/size.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "geotiff": "^3.0.5",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.10.1",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.5"
  }
}
